{
    "default_profile": "h265 nvenc 10bit HDR",
    "profiles": {
        "h265 nvenc 10bit HDR": {
            "ffmpeg_args": [
                "-map", "0",
                "-c:v", "hevc_nvenc",
                "-preset", "p7", 
                "-cq", "23",
                "-rc", "vbr",
                "-multipass", "fullres",
                "-pix_fmt", "p010le",
                "-color_primaries", "bt2020",
                "-color_trc", "smpte2084",
                "-colorspace", "bt2020nc",
                "-color_range", "tv",
                "-c:a", "copy",
                "-c:s", "copy",
                "-map_metadata", "0"
            ]
        },
        "h265 nvenc 10bit SDR": {
            "ffmpeg_args": [
                "-map", "0",
                "-c:v", "hevc_nvenc",
                "-preset", "p7",
                "-rc", "vbr",
                "-multipass", "fullres",
                "-cq", "25",
                "-pix_fmt", "yuv420p10le",
                "-c:a", "copy",
                "-c:s", "copy",
                "-map_metadata", "0"
            ]
        },
        "h265 10bit": {
            "ffmpeg_args": [
                "-map", "0",
                "-c:v", "libx265",
