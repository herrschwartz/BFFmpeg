                "-crf", "22",
                "-pix_fmt", "yuv420p10le",
                "-c:a", "copy",
                "-c:s", "copy",
                "-map_metadata", "0"
            ]
        },
        "h265 10bit Animation": {
            "ffmpeg_args": [
