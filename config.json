                "-c:a", "copy",
                "-c:s", "copy",
                "-map_metadata", "0"
            ]
        },
        "h265 10bit Low": {
            "ffmpeg_args": [
                "-map", "0",
                "-c:v", "libx265",
                "-preset", "slow",
                "-crf", "25",
                "-pix_fmt", "yuv420p10le",
                "-c:a", "copy",
                "-c:s", "copy",
                "-map_metadata", "0"
            ]
        }
